{
  "manifest_version": 3,
  "name": "TestSnapper",
  "description": "Record UI test sessions with smart field detection, locator extraction, and export to DOCX, PDF, and JSON.",
  "version": "0.0.0",
  "author": "TestSnapper Team",
  "offline_enabled": true,
  "minimum_chrome_version": "91",

  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "unlimitedStorage",
    "downloads",
    "scripting",
    "notifications",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },

  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "<all_urls>",
        "file:///*"
      ],
      "js": [
        "src/core/logger.js",
        "src/content/selector.js",
        "src/content/field-name-resolver.js",
        "src/content/redactor.js",
        "src/content/content.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ],

  "action": {
    "default_popup": "src/ui/popup/popup.html",
    "default_title": "TestSnapper - Record UI Tests",
    "default_icon": {
      "16": "src/assets/icons/icon16.png",
      "48": "src/assets/icons/icon48.png",
      "128": "src/assets/icons/icon128.png"
    }
  },

  "icons": {
    "16": "src/assets/icons/icon16.png",
    "48": "src/assets/icons/icon48.png",
    "128": "src/assets/icons/icon128.png"
  },

  "commands": {
    "capture_screenshot": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Capture screenshot"
    },
    "toggle_recording": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Pause/Resume recording"
    },
    "stop_recording": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Stop recording"
    }
  },

  "web_accessible_resources": [{
    "resources": [
      "src/assets/icons/*"
    ],
    "matches": ["chrome-extension://*/*"]
  }]
}
