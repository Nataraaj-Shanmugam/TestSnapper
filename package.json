{
  "name": "testsnapper-extension",
  "version": "1.1.7",
  "description": "TestSnapper Browser Extension - Record UI test sessions with automated field detection and multi-format export",
  "scripts": {
    "build": "cross-env NODE_ENV=production webpack --mode=production",
    "build:dev": "cross-env NODE_ENV=development webpack --mode=development",
    "dev": "cross-env NODE_ENV=development webpack --mode=development --watch",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "setup-libs": "node scripts/download-libs.js",
    "setup": "npm install && npm run setup-libs && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report"
  },
  "engines": { "node": ">=18.0.0" },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@playwright/test": "^1.58.2",
    "@vitest/coverage-v8": "^4.1.0",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^11.0.0",
    "cross-env": "^10.1.0",
    "jsdom": "^27.0.1",
    "vitest": "^3.2.4",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}
