{
  "name": "testsnapper-extension",
  "version": "1.1.0",
  "description": "TestSnapper Browser Extension with AI-powered step enrichment",
  "scripts": {
    "build": "webpack --mode=production",
    "dev": "webpack --mode=development --watch",
    "install-webllm": "npm install @mlc-ai/web-llm",
    "setup": "npm run install-webllm && npm run build"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.79"
  },
  "devDependencies": {
    "copy-webpack-plugin": "^11.0.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "webpack": {
    "entry": {
      "webllm-service": "./src/webllm-service.js"
    },
    "output": {
      "path": "./dist",
      "filename": "[name].js",
      "library": {
        "type": "module"
      }
    },
    "experiments": {
      "outputModule": true
    }
  }
}
